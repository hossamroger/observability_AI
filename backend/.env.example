# Never commit real tokens. Use protected secrets or process environment variables.
SPRING_PROFILES_ACTIVE=local
# Production profile: weblogic (requires JNDI datasource and Oracle DDL)
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secure/location/service-account.json
DYNATRACE_URL=
DYNATRACE_TOKEN=
DYNATRACE_METRIC_SELECTOR=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PATTERN=logs-*
ELASTICSEARCH_LEVEL_FIELD=log.level
ELASTICSEARCH_ERROR_VALUE=ERROR
OBS_COLLECTOR_ENABLED=false
OBS_GA4_ENABLED=false
OBS_DYNATRACE_ENABLED=false
OBS_ELK_ENABLED=false
